{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "EasyADB",
  "version": "../package.json",
  "identifier": "com.easyadb.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EasyADB",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "publisher": "aybrkaknc",
    "copyright": "Copyright (C) aybrkaknc. Licensed under GPL-3.0-only.",
    "category": "DeveloperTool",
    "shortDescription": "Android device manager over ADB",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/adb", "binaries/fastboot"],
    "resources": {
      "binaries/AdbWinApi.dll": "AdbWinApi.dll",
      "binaries/AdbWinUsbApi.dll": "AdbWinUsbApi.dll",
      "binaries/NOTICE.txt": "licenses/platform-tools-NOTICE.txt"
    },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "wix": { "language": ["en-US", "tr-TR"] }
    }
  }
}
